# Paths are relative to the project root. SQLite is the only supported database.
DATABASE_URL=sqlite:///data/runtime/word_guess.db
SQLITE_BUSY_TIMEOUT=5000
APP_HOST=127.0.0.1
APP_PORT=8000
VITE_PORT=5173
SESSION_DAYS=30
# Set true when serving through an HTTPS reverse proxy.
COOKIE_SECURE=false
# Optional exact trusted origins as a JSON array, e.g. ["https://words.example"].
AUTH_ALLOWED_ORIGINS=[]
